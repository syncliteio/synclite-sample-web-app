<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>SyncLiteSampleApp</display-name>
  <welcome-file-list>
    <welcome-file>selectDBDirectory.jsp</welcome-file>
  </welcome-file-list>
  <filter>
    <filter-name>SecurityHeadersAndCSRFFilter</filter-name>
    <filter-class>com.synclite.sample.SecurityHeadersAndCSRFFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>SecurityHeadersAndCSRFFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <session-config>
    <session-timeout>30</session-timeout>
    <tracking-mode>COOKIE</tracking-mode>
    <cookie-config>
      <http-only>true</http-only>
      <secure>true</secure>
    </cookie-config>
  </session-config>
</web-app>